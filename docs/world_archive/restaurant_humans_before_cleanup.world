<?xml version="1.0"?>

<sdf version="1.6">

  <world name="restaurant_party_hall">

    <!-- Standard Earth gravity. -->
    <gravity>0 0 -9.81</gravity>

    <!-- Gazebo Classic physics configuration. -->
    <physics name="restaurant_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- General visual settings. -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Main directional light. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <pose>0 0 12 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <!-- Ceiling light positioned above the left side of the hall. -->
    <light name="ceiling_light_left" type="point">
      <pose>-5 0 4.5 0 0 0</pose>

      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>

      <attenuation>
        <range>16</range>
        <constant>0.7</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ceiling light positioned above the centre of the hall. -->
    <light name="ceiling_light_centre" type="point">
      <pose>0 0 4.5 0 0 0</pose>

      <diffuse>0.90 0.90 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>

      <attenuation>
        <range>16</range>
        <constant>0.7</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ceiling light positioned above the right side of the hall. -->
    <light name="ceiling_light_right" type="point">
      <pose>5 0 4.5 0 0 0</pose>

      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>

      <attenuation>
        <range>16</range>
        <constant>0.7</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>

    <!--
      RESTAURANT FLOOR

      Dimensions:
      X = 20 metres
      Y = 15 metres
      Z = 0.10 metres
    -->
    <model name="restaurant_floor">
      <static>true</static>

      <pose>0 0 -0.05 0 0 0</pose>

      <link name="floor_link">

        <collision name="floor_collision">
          <geometry>
            <box>
              <size>20 15 0.10</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>20 15 0.10</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- North exterior wall. -->
    <model name="north_wall">
      <static>true</static>

      <pose>0 7.40 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.20 3.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.20 3.00</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- East exterior wall. -->
    <model name="east_wall">
      <static>true</static>

      <pose>9.90 0 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.20 15 3.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.20 15 3.00</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- West exterior wall. -->
    <model name="west_wall">
      <static>true</static>

      <pose>-9.90 0 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.20 15 3.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.20 15 3.00</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!--
      South wall, left section.

      The gap between the left and right sections forms the main entrance.
    -->
    <model name="south_wall_left">
      <static>true</static>

      <pose>-5.50 -7.40 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>9.00 0.20 3.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>9.00 0.20 3.00</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- South wall, right section. -->
    <model name="south_wall_right">
      <static>true</static>

      <pose>5.50 -7.40 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>9.00 0.20 3.00</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>9.00 0.20 3.00</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- Kitchen east-side partition. -->
    <model name="kitchen_east_partition">
      <static>true</static>

      <pose>-6.20 4.75 1.40 0 0 0</pose>

      <link name="partition_link">

        <collision name="partition_collision">
          <geometry>
            <box>
              <size>0.15 5.30 2.80</size>
            </box>
          </geometry>
        </collision>

        <visual name="partition_visual">
          <geometry>
            <box>
              <size>0.15 5.30 2.80</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- Kitchen lower partition, left of its doorway. -->
    <model name="kitchen_south_partition_left">
      <static>true</static>

      <pose>-9.20 2.10 1.40 0 0 0</pose>

      <link name="partition_link">

        <collision name="partition_collision">
          <geometry>
            <box>
              <size>1.40 0.15 2.80</size>
            </box>
          </geometry>
        </collision>

        <visual name="partition_visual">
          <geometry>
            <box>
              <size>1.40 0.15 2.80</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- Kitchen lower partition, right of its doorway. -->
    <model name="kitchen_south_partition_right">
      <static>true</static>

      <pose>-6.65 2.10 1.40 0 0 0</pose>

      <link name="partition_link">

        <collision name="partition_collision">
          <geometry>
            <box>
              <size>0.90 0.15 2.80</size>
            </box>
          </geometry>
        </collision>

        <visual name="partition_visual">
          <geometry>
            <box>
              <size>0.90 0.15 2.80</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- Raised stage positioned at the upper-right side of the hall. -->
    <model name="restaurant_stage">
      <static>true</static>

      <pose>7.45 5.20 0.15 0 0 0</pose>

      <link name="stage_link">

        <collision name="stage_collision">
          <geometry>
            <box>
              <size>4.50 3.60 0.30</size>
            </box>
          </geometry>
        </collision>

        <visual name="stage_visual">
          <geometry>
            <box>
              <size>4.50 3.60 0.30</size>
            </box>
          </geometry>

          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <!-- Initial Gazebo GUI camera position. -->
    <gui fullscreen="0">
      <camera name="restaurant_overview_camera">
        <pose>0 -21 17 0 0.62 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  

    <!-- ========================================================= -->
    <!-- LIRS HUMAN TEST 01                                        -->
    <!-- Male suit model using the talking animation.               -->
    <!-- First actor test before adding complete social groups.      -->
    <!-- ========================================================= -->

    <actor name="person_01_male_suit">

      <!--
        Actor's base pose is kept at the origin.
        The trajectory below gives the actual world position.
      -->
      <pose>0 0 0 0 0 0</pose>

      <!-- Human appearance and embedded skeletal animation. -->
      <skin>
        <filename>
          model://actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>

        <scale>1.0</scale>
      </skin>

      <!-- Talking animation supplied by LIRS-HMLG. -->
      <animation name="talking">
        <filename>
          model://actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>

        <scale>1.0</scale>

        <!--
          This actor is talking in one location rather than
          translating through the environment.
        -->
        <interpolate_x>false</interpolate_x>
      </animation>

      <!-- Keep the talking animation running continuously. -->
      <script>

        <loop>true</loop>

        <delay_start>0.0</delay_start>

        <auto_start>true</auto_start>

        <trajectory id="0" type="talking">

          <!-- Person remains at the same location for 30 seconds. -->
          <waypoint>
            <time>0.0</time>
            <pose>-3.6 1.0 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>30.0</time>
            <pose>-3.6 1.0 0 0 0 0</pose>
          </waypoint>

        </trajectory>

      </script>

    </actor>
      <!-- ========================================================= -->
    <!-- HUMAN 01 - Standing / Talking Male                        -->
    <!-- Source: LIRS-HMLG Male/m_suit                             -->
    <!-- ========================================================= -->

    <actor name="human_01_male_suit">

      <!-- Initial actor reference pose -->
      <pose>0 0 0 0 0 0</pose>

      <!-- Human mesh -->
      <skin>
        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>
        <scale>1.0</scale>
      </skin>

      <!-- Talking animation -->
      <animation name="talk">
        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>

        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>

      <!-- Animation behaviour -->
      <script>

        <loop>true</loop>

        <delay_start>0.0</delay_start>

        <auto_start>true</auto_start>

        <trajectory id="0" type="talk">

          <!-- Human remains at this location -->
          <waypoint>
            <time>0.0</time>
            <pose>-3.5 1.5 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>30.0</time>
            <pose>-3.5 1.5 0 0 0 0</pose>
          </waypoint>

        </trajectory>

      </script>

    </actor>

  </world>

</sdf>
