    <actor name="human_01_male_suit">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>
        <scale>1.0</scale>
      </skin>
      <animation name="talk">
        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="talk">
          <waypoint>
            <time>0.0</time>
            <pose>-3.5 1.5 0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>30.0</time>
            <pose>-3.5 1.5 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ========================================================= -->
    <!-- GROUP 01 - HUMAN 02                                       -->
    <!-- Female casual model performing talking animation.          -->
    <!-- ========================================================= -->
    <actor name="human_02_female_casual">

      <!--
        Keep the actor's base reference at the origin.
        The trajectory waypoint below controls its world position.
      -->
      <pose>0 0 0 0 0 0</pose>
        <!--
        The skin determines the visible human body.
        We use an absolute file URI because this was more reliable
        for the external LIRS-HMLG actor library.
        -->
      <skin>

        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Female/w_casual/talk.dae
        </filename>

        <scale>1.0</scale>

      </skin>
      <!-- Talking skeletal animation. -->
      <animation name="talk">

        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Female/w_casual/talk.dae
        
        </filename>

        <scale>1.0</scale>

      <!--
      The human talks at one location instead of moving
      through the restaurant.
      -->
        <interpolate_x>false</interpolate_x>

      </animation>

      <script>

        <!-- Keep repeating the talking animation. -->
        <loop>true</loop>

        <!-- Start immediately when Gazebo begins. -->
        <delay_start>0.0</delay_start>

        <auto_start>true</auto_start>

        <trajectory id="1" type="talk">

        <!--
        POSITION:
          X   = -1.9 m
          Y   =  1.5 m
          Z   =  0.0 m

        ORIENTATION:
          Yaw = 3.14159 rad = approximately 180 degrees

        This initially makes Human 02 face opposite Human 01.
        -->
          <waypoint>

            <time>0.0</time>

            <pose>
              -1.9 1.5 0 0 0 3.14159
            </pose>

          </waypoint>

          <!--
           Same pose later in time means the person stays
           in the same physical location while talking.
          -->
          <waypoint>

            <time>30.0</time>

            <pose>
              -1.9 1.5 0 0 0 3.14159
            </pose>

          </waypoint>

        </trajectory>

      </script>

    </actor>
  </world>
