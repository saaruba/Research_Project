          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Kitchen / service area partitions. -->
    <model name="kitchen_east_partition">
      <static>true</static>
      <pose>-6.20 4.75 1.40 0 0 0</pose>
      <link name="partition_link">
        <collision name="partition_collision">
          <geometry><box><size>0.15 5.30 2.80</size></box></geometry>
        </collision>
        <visual name="partition_visual">
