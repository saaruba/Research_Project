          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Stage remains in place; furniture and stage objects will be added later. -->
    <model name="restaurant_stage">
      <static>true</static>
      <pose>7.45 5.20 0.15 0 0 0</pose>
      <link name="stage_link">
        <collision name="stage_collision">
          <geometry><box><size>4.50 3.60 0.30</size></box></geometry>
        </collision>
        <visual name="stage_visual">
          <geometry><box><size>4.50 3.60 0.30</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="restaurant_overview_camera">
        <pose>0 -21 17 0 0.62 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ============================================================= -->
    <!-- HUMAN POPULATION                                               -->
    <!-- Fixed implementation of the reference-plan ranges:             -->
    <!--   30 standing people = 24 talking + 6 walking                  -->
    <!--   18 sitting people                                            -->
    <!--   TOTAL = 48 humans                                            -->
    <!-- Demographic mix: 18 adult men, 18 adult women, 12 children.    -->
    <!-- ============================================================= -->
    <!-- 24 stationary conversational-group members (Groups 01-06). -->


