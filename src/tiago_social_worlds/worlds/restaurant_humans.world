          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="kitchen_south_partition_left">
      <static>true</static>
      <pose>-9.20 2.10 1.40 0 0 0</pose>
      <link name="partition_link">
        <collision name="partition_collision">
          <geometry><box><size>1.40 0.15 2.80</size></box></geometry>
        </collision>
        <visual name="partition_visual">
          <geometry><box><size>1.40 0.15 2.80</size></box></geometry>
