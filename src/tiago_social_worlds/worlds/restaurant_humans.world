<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="restaurant_party_hall">
    <gravity>0 0 -9.81</gravity>

    <physics name="restaurant_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Balanced indoor lighting for VNC/software-rendered Gazebo Classic. -->
    <scene>
      <ambient>0.28 0.28 0.28 1</ambient>
      <background>0.30 0.32 0.35 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.55 0.55 0.52 1</diffuse>
      <specular>0.06 0.06 0.06 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <!-- 20 m x 15 m restaurant floor. -->
    <model name="restaurant_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>20 15 0.10</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>20 15 0.10</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Exterior walls. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 7.40 1.50 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>20 0.20 3.00</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>20 0.20 3.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>9.90 0 1.50 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.20 15 3.00</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.20 15 3.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-9.90 0 1.50 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.20 15 3.00</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.20 15 3.00</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <!-- South wall split to preserve the main entrance. -->
    <model name="south_wall_left">
      <static>true</static>
      <pose>-5.50 -7.40 1.50 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>9.00 0.20 3.00</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>9.00 0.20 3.00</size></box></geometry>
