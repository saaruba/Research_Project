    <!-- ===================================================== -->
    <!-- CAMERA                                                -->
    <!-- ===================================================== -->

    <gui fullscreen="0">

      <camera name="restaurant_overview_camera">

        <pose>0 -21 17 0 0.62 1.57</pose>

        <view_controller>orbit</view_controller>

      </camera>

    </gui>


    <!-- ===================================================== -->
    <!-- TABLES                                                -->
    <!-- ===================================================== -->


    <!-- TABLE 1 : (-4,-1) -->

    <include>

      <uri>
        model://free-wooden-round-dining-table-3d-model
      </uri>

      <name>restaurant_table_01</name>

      <pose>-4 -1 0 0 0 0</pose>

      <static>true</static>

    </include>


    <!-- TABLE 2 : (-1,+4) -->

    <include>

      <uri>
        model://free-wooden-round-dining-table-3d-model
