<?xml version="1.0" encoding="utf-8"?>

<sdf version="1.6">

  <world name="restaurant_party_hall">
    <!-- Added by scripts/add_gazebo_ros_plugins.py -->
    <!-- gazebo_ros_factory provides /spawn_entity. Without it, TIAGo cannot be
         inserted into this world and every downstream system fails. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>


    <!-- ===================================================== -->
    <!-- PHYSICS                                               -->
    <!-- ===================================================== -->

    <gravity>0 0 -9.81</gravity>

    <physics name="restaurant_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ===================================================== -->
    <!-- SCENE / LIGHTING                                      -->
    <!-- ===================================================== -->

    <scene>
      <ambient>0.28 0.28 0.28 1</ambient>
      <background>0.30 0.32 0.35 1</background>
      <shadows>false</shadows>
    </scene>


    <light name="sun" type="directional">

      <cast_shadows>false</cast_shadows>

      <pose>0 0 12 0 0 0</pose>

      <diffuse>0.55 0.55 0.52 1</diffuse>

      <specular>0.06 0.06 0.06 1</specular>

      <direction>-0.4 0.2 -1.0</direction>

    </light>


    <!-- ===================================================== -->
    <!-- RESTAURANT FLOOR                                      -->
    <!-- 20 m X 15 m                                          -->
    <!-- ===================================================== -->

    <model name="restaurant_floor">

      <static>true</static>

      <pose>0 0 -0.05 0 0 0</pose>

      <link name="floor_link">

        <collision name="floor_collision">

          <geometry>
            <box>
              <size>20 15 0.10</size>
            </box>
          </geometry>

        </collision>


        <visual name="floor_visual">

          <geometry>
            <box>
              <size>20 15 0.10</size>
            </box>
          </geometry>

          <material>

            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>

          </material>

        </visual>

      </link>

    </model>


    <!-- ===================================================== -->
    <!-- NORTH WALL                                            -->
    <!-- ===================================================== -->

    <model name="north_wall">

      <static>true</static>

      <pose>0 7.40 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">

          <geometry>
            <box>
              <size>20 0.20 3.00</size>
            </box>
          </geometry>

        </collision>


        <visual name="wall_visual">

          <geometry>
            <box>
              <size>20 0.20 3.00</size>
            </box>
          </geometry>

          <material>

            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>

          </material>

        </visual>

      </link>

    </model>


    <!-- ===================================================== -->
    <!-- EAST WALL                                             -->
    <!-- ===================================================== -->

    <model name="east_wall">

      <static>true</static>

      <pose>9.90 0 1.50 0 0 0</pose>

      <link name="wall_link">

        <collision name="wall_collision">

          <geometry>
            <box>
              <size>0.20 15 3.00</size>
            </box>
          </geometry>

