    <gui fullscreen="0">
      <camera name="restaurant_overview_camera">
        <pose>0 -21 17 0 0.62 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <!-- 24 talking actors: six four-person F-formation groups. -->
    <!-- GROUP 1 centre (-3.5, 4.7) -->
    <!-- DEVELOPMENT POPULATION: 15 humans = 12 talking (3 groups of 4) + 3 walking; no seated actors. -->
    
    <!-- ===================================================== -->
    <!-- FINAL HUMAN POPULATION                                -->
    <!-- 7 humans total: 3 talking, 3 standing, 1 walking     -->
    <!-- ===================================================== -->

    <!-- GROUP 1: P1(-3,0), P2(-3,-1), P3(-4,0) -->

    <actor name="group_01_person_01_talking">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="talk">
        <filename>file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="101" type="talk">
          <waypoint><time>0</time><pose>-3 0 0 0 0 -2.3562</pose></waypoint>
          <waypoint><time>30</time><pose>-3 0 0 0 0 -2.3562</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="group_01_person_02_standing">
      <pose>-3 -1 0 0 0 2.0344</pose>
      <skin>
        <filename>file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Female/w_casual/talk.dae</filename>
        <scale>1.0</scale>
      </skin>
    </actor>

    <actor name="group_01_person_03_talking">
