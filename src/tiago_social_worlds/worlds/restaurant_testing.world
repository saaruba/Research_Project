        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.6</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="102" type="talk">
          <waypoint><time>0</time><pose>-4 0 0 0 0 -0.4636</pose></waypoint>
          <waypoint><time>30</time><pose>-4 0 0 0 0 -0.4636</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- GROUP 2: P1(-1,5), P2(0,5), P3(0,4), P4(-2,5) -->

