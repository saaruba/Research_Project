    <!-- ===================================================== -->
    <!-- HUMAN GROUP 1                                        -->
    <!--                                                      -->
    <!-- Person 1 = (-3, 0)                                   -->
    <!-- Person 2 = (-3,-1)                                   -->
    <!-- Person 3 = (-4, 0)                                   -->
    <!--                                                      -->
    <!-- Group centre approximately (-3.33,-0.33)              -->
    <!-- ===================================================== -->


    <!-- ===================================================== -->
    <!-- GROUP 1 - PERSON 1 - TALKING                          -->
    <!-- Position (-3,0)                                      -->
    <!-- Faces group centre                                   -->
    <!-- ===================================================== -->

    <actor name="group_01_person_01_talking">

      <pose>0 0 0 0 0 0</pose>

      <skin>

        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>

        <scale>1.0</scale>

      </skin>


      <animation name="talk">

        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Male/m_suit/talk.dae
        </filename>

        <scale>1.0</scale>

        <interpolate_x>false</interpolate_x>

      </animation>


      <script>

        <loop>true</loop>

        <delay_start>0.0</delay_start>

        <auto_start>true</auto_start>

        <trajectory id="101" type="talk">

          <waypoint>

            <time>0</time>

            <pose>
              -3 0 0 0 0 -2.3562
            </pose>

          </waypoint>


          <waypoint>

            <time>30</time>

            <pose>
              -3 0 0 0 0 -2.3562
            </pose>

          </waypoint>

        </trajectory>

      </script>

    </actor>


    <!-- ===================================================== -->
    <!-- GROUP 1 - PERSON 2 - STATIC STANDING                  -->
    <!-- Position (-3,-1)                                     -->
    <!-- Yaw = 2.0344 rad                                     -->
    <!-- ===================================================== -->

    <actor name="group_01_person_02_static">

      <pose>
        -3 -1 0 0 0 2.0344
      </pose>

      <skin>

        <filename>
          file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Female/w_casual/talk.dae
        </filename>

        <scale>1.0</scale>

      </skin>

    </actor>


    <!-- ===================================================== -->
    <!-- GROUP 1 - PERSON 3 - TALKING                          -->
    <!-- Position (-4,0)                                      -->
