    <!-- ===================================================== -->
    <!-- HUMAN GROUP 1                                        -->
    <!-- ===================================================== -->

    <!-- PERSON 1 -->
    <actor name="final_group1_person_01">
      <pose>0 0 0 0 0 0</pose>
      <skin>
        <filename>file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Female/w_casual/talk.dae</filename>
        <scale>1.0</scale>
      </skin>

      <animation name="talk">
        <filename>file:///workspaces/Research_Project/models/actors/LIRS-HMLG/Female/w_casual/talk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>

      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>

        <trajectory id="501" type="talk">
          <!-- Local zero-offset waypoints keep the actor at (-2 -2). -->
          <waypoint>
            <time>0</time>
            <pose>-3 -2 0 0 0 -0.7854</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>-3 -2 0 0 0 -0.7854</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>


